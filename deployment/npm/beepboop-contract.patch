+test('kprint: a managed upload has no acceptance receipt until its subprocess completes', async () => {
+  world.npm.publish('@octo/tool', '1.0.0');
+  world.npm.publish('@octo/tool-linux-x64', '1.0.0');
+  const { repository, begun } = await released({ main: [toolLinux, tool] }, generatedLayout);
+  const { execution, identity } = started(begun, 'main');
+  const state = packTarballs(['@octo/tool-linux-x64', '@octo/tool'], '1.1.0');
+  const completion = Promise.withResolvers<void>();
+  const startedUpload = Promise.withResolvers<void>();
+  const publish = tarballs(state);
+  let delayed = false;
+  const publication = publishing(identity, execution.id, {
+    run: argv => {
+      if (argv[0] !== 'npm' || delayed) return publish(argv);
+      delayed = true;
+      return Effect.gen(function* () {
+        startedUpload.resolve();
+        yield* Effect.promise(() => completion.promise);
+        return yield* publish(argv);
+      });
+    },
+    credentials: { NODE_AUTH_TOKEN: 'npm-token' }, tarballs: join(target, 'tarballs'),
+  });
+  await startedUpload.promise;
+  try {
+    expect((await ledgerOf(repository, execution.id)).records[0]?.status.state).toBe('claimed');
+    expect((await executionOf(repository, execution.id)).publications.every(entry => entry.outcome !== 'succeeded')).toBe(true);
+  } finally {
+    completion.resolve();
+  }
+  const result = await publication;
+  if (result.result._tag === 'Failure') throw new Error(result.result.failure.message);
+  expect((await ledgerOf(repository, execution.id)).records.every(record => record.status.state === 'published')).toBe(true);
+}, 60_000);
