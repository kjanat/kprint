+test('kprint: successful npm uploads remain incomplete until GitHub publication recovers', async () => {
+  world.npm.publish('@octo/tool', '1.0.0');
+  world.npm.publish('@octo/tool-linux-x64', '1.0.0');
+  const { repository, begun } = await released({ main: [toolLinux, tool] }, splitLayout);
+  const { execution, identity } = started(begun, 'main');
+  const state = packTarballs(['@octo/tool-linux-x64', '@octo/tool'], '1.1.0');
+  const result = await publishing(identity, execution.id, {
+    run: tarballs(state), credentials: { NODE_AUTH_TOKEN: 'npm-token' }, tarballs: join(target, 'tarballs'),
+  });
+  if (result.result._tag === 'Failure') throw new Error(result.result.failure.message);
+  expect(Effect.runSync(Effect.result(requireAll(result.result.success)))._tag).toBe('Success');
+  const publication = () => withIdentity(world, identity, () => Effect.runPromise(workflowCall(world, '/api/workflow/release', { executionId: execution.id })));
+  await expect(publication()).rejects.toThrow('Publish the release tag before the release');
+  expect((await executionOf(repository, execution.id)).state).not.toBe('succeeded');
+  expect((await ledgerOf(repository, execution.id)).records.every(record => record.status.state === 'published')).toBe(true);
+  world.github.recordTag(repository, 'v1.1.0', 'a'.repeat(40), execution.sourceSha, true);
+  await publication();
+  const run = repository.runs.find(entry => entry.id === identity.runId)!;
+  run.status = 'completed'; run.conclusion = 'success';
+  await world.workflowRun(repository, run, 'success', 'workflow_dispatch');
+  await world.wait(2_000);
+  expect((await executionOf(repository, execution.id)).state).toBe('succeeded');
+  expect(state.commands.filter(command => command.startsWith('npm publish'))).toHaveLength(2);
+}, 60_000);
